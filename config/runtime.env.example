# Copy this to a protected file outside the repository before configuring Runtime.
APP_LISTEN=127.0.0.1:8080
DATABASE_URL=

# Optional Teltonika TCP output. Point this at an external compatible Gateway, or
# leave it blank when TELTONIKA_GATEWAY_LISTEN is enabled so the simulator routes
# its own Codec 8E telemetry through the in-process Gateway listener.
TELTONIKA_GATEWAY_ADDR=
TELTONIKA_GATEWAY_TIMEOUT=5s

# Optional project-owned Teltonika -> HTTP Gateway. Enabling the listener requires
# HEXA_SENSOR_URL and HEXA_SENSOR_SECRET_KEY. Keep the real secret only in the
# protected environment file; never commit it.
TELTONIKA_GATEWAY_LISTEN=127.0.0.1:5027
HEXA_SENSOR_URL=
HEXA_SENSOR_SECRET_KEY=
HEXA_SENSOR_TIMEOUT=5s
