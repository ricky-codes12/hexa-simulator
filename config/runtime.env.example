# Copy this to a protected file outside the repository before configuring Runtime.
APP_LISTEN=127.0.0.1:8080
DATABASE_URL=

# Optional Teltonika TCP output for testing against an external compatible Gateway.
TELTONIKA_GATEWAY_ADDR=
TELTONIKA_GATEWAY_TIMEOUT=5s

# Inbound HEXA.SENSOR integration. HEXA.SENSOR sends this value in the
# X-SECRET-KEY header when polling GET /api/integration/devices. Keep the real
# value only in the protected environment file; never commit it.
HEXA_SENSOR_SECRET_KEY=
