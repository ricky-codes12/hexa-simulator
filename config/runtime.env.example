# Copy this to a protected file outside the repository before configuring Runtime.
APP_LISTEN=127.0.0.1:8080
DATABASE_URL=

# Required when DATABASE_URL is configured. Keep these values in protected runtime configuration.
SIM_ADMIN_USERNAME=hexa-dev
SIM_ADMIN_PASSWORD=replace-with-a-strong-12-plus-character-password
SIM_SECURITY_KEY=replace-with-a-random-secret-at-least-32-characters
# Set true when served through HTTPS.
SIM_COOKIE_SECURE=false

# The seeded fleet: empty for 350 units, a total such as 120, off, or counts such as
# haul-truck=40,farm-tractor=10. The seed makes every run the same.
SIM_FLEET=
SIM_SEED=7
SIM_REPORT_INTERVAL=5s

# MQTT 3.1.1 QoS 1 output, for Hexa.Sensor mqtt-subscribe. The topic template knows {imei}, {kind}
# and {estate}. On bn2 the broker is mqtt://127.0.0.1:19300 as user hexa-simulator.
SIM_MQTT_URL=
SIM_MQTT_USERNAME=
SIM_MQTT_PASSWORD=
SIM_MQTT_CLIENT_ID=hexa-simulator
SIM_MQTT_TOPIC={imei}/data
SIM_MQTT_TIMEOUT=5s

# Teltonika Direct: one TCP session per IMEI to a Teltonika listener such as Hexa.Sensor's
# teltonika-tcp source. Codec 8E by default; set 8 for Codec 8.
TELTONIKA_GATEWAY_ADDR=
TELTONIKA_GATEWAY_TIMEOUT=5s
TELTONIKA_CODEC=8E

# Hexa.Sensor HTTP push: the source's endpoint and ingest key, configured together.
SIM_SENSOR_PUSH_URL=
SIM_SENSOR_PUSH_KEY=
SIM_SENSOR_PUSH_TIMEOUT=5s
